# Datos: contienen números de cuenta y correos (datos personales). Nunca se versionan.
data/*/*
!data/*/.gitkeep

# Entorno y cachés de Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Archivos temporales de Office y del sistema
~$*
*.tmp
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Configuración local de herramientas
.claude/

# Documentos: se generan localmente y no se suben a Git (solo las figuras)
docs/*
!docs/figuras/
